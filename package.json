{
  "name": "ecommerce-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "dev:otel": "node --env-file-if-exists=.env --env-file-if-exists=.env.otel --import ./server/otel/instrumentation.js server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:otel": "node --env-file-if-exists=.env --env-file-if-exists=.env.otel --import ./server/otel/instrumentation.js server/index.js",
    "lint": "oxlint",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/db/seed.js",
    "test:e2e:migrate": "node --env-file-if-exists=.env.test server/db/migrate.js",
    "test:e2e:reset": "node --env-file-if-exists=.env.test tests/e2e/reset-db.js",
    "test:e2e:seed": "node --env-file-if-exists=.env.test server/db/seed.js",
    "test:e2e:setup": "npm run test:e2e:migrate && npm run test:e2e:reset && npm run test:e2e:seed",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:e2e:ui": "npm run test:e2e:setup && playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-auth": "^1.6.29",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
