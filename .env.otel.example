# Copy this file to .env.otel (gitignored) and fill in your own Grafana Cloud values.
# Get both from your Grafana Cloud stack: Connections -> Add new connection -> OpenTelemetry.
# That page shows a ready-to-copy OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS
# pair (with the Basic Auth token already base64-encoded) — paste it in as-is.
# See observability/README.md for the full walkthrough.

OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64(instanceID:apiKey)>
